{
  "name": "@web-repo-to-ai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node run.js vite dev",
    "build": "node run.js vite build",
    "preview": "node run.js vite preview",
    "check": "node run.js svelte-kit sync && node run.js svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "node run.js svelte-kit sync && node run.js svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node run.js vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "tinypool": "^2.1.2",
    "@vitest/mocker": "^4.1.12"
  }
}
