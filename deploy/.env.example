# web-repo-to-ai Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Database Configuration (PostgreSQL)
POSTGRES_DB=webrepotodev
POSTGRES_USER=webrepouser
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://webrepouser:devpassword123@127.0.0.1:5432/webrepotodev

# API & Worker Configuration
API_PORT=8080
API_HOST=127.0.0.1
RUST_LOG=info,web_repo_to_ai=debug

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/artifacts

# Browser Worker URL (Isolated Chromium)
BROWSER_WORKER_URL=http://127.0.0.1:3000

# Web Frontend Configuration
PUBLIC_API_URL=http://127.0.0.1:8080/api/v1
WEB_PORT=5173
WEB_HOST=127.0.0.1

# Optional GitHub App Credentials (for private repository access)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
